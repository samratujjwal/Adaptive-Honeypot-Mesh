NODE_ENV=development
LOG_LEVEL=info
SSH_PORT=2222
HTTP_PORT=8080
HTTP_SERVER_HEADER=nginx/1.18.0 (Ubuntu)
HTTP_MAX_BODY_BYTES=65536
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_CONNECTIONS_PER_IP=20
HTTP_MAX_REQ_PER_MIN_PER_IP=300
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_LLM_ENABLED=true
HTTP_LLM_DEADLINE_MS=5000
HTTP_SESSION_WINDOW_MS=1800000
FTP_PORT=2121
BIND_HOST=127.0.0.1
SSH_IDLE_TIMEOUT_MS=120000
SSH_MAX_SESSION_MS=600000
SSH_MAX_CONNECTIONS=50
SSH_MAX_CONNECTIONS_PER_IP=5
SSH_MAX_AUTH_ATTEMPTS=6
SSH_LLM_DEADLINE_MS=8000
SSH_MAX_FILE_BYTES=65536
SSH_MAX_NODES=2000
SSH_MAX_PENDING_INPUT=4096
HONEYPOT_STATIC_FIRST=true
SSH_IDENT=OpenSSH_8.9p1 Ubuntu-3ubuntu0.6
HONEYPOT_HOSTNAME=srv-web-01
ALLOW_PUBLIC_BIND=false
EVENT_DIR=data/events
SSH_HOST_KEY_PATH=data/ssh/host_ed25519
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=8000
LLM_RPM=8
LLM_DAILY_LIMIT=400
LLM_SESSION_LIMIT=40
LLM_CACHE_MAX=500
LLM_CACHE_TTL_MS=3600000
LLM_MAX_OUTPUT_CHARS=4000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.4
GEMINI_THINKING_BUDGET=0
LLM_USAGE_FILE=data/llm-usage.json
KAFKA_BROKERS=localhost:9092
ELASTICSEARCH_URL=http://localhost:9200
NODE_ID=node-01
